{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scilab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Daily push reminder at 16:00 UTC; leaderboard wiped on the 1st of each month at 03:00 UTC; extra month-end teaser push at 18:00 UTC on the last day.
  // Daily reminder time in Cairo: 6 pm winter, 7 pm summer.
  // Public Google OAuth Client ID for the optional "Link Google account" button (not a secret). Empty hides the button.
  "vars": { "GOOGLE_CLIENT_ID": "" },
  "triggers": { "crons": ["0 16 * * *", "0 3 1 * *", "0 18 28-31 * *"] },
  // D1 database for the leaderboard and push reminders (created in the Cloudflare dashboard).
  "d1_databases": [
    { "binding": "DB", "database_name": "scilab", "database_id": "f1cdc269-9664-4b38-a84a-64421b00045a" }
  ]
}
